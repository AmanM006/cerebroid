# Copy this file to .env and fill in real values.
# Never commit the real .env (enforced by .gitignore + gitleaks).

# --- app ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins (CORS allowlist).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host port for the web container (frontend + API proxy).
WEB_PORT=8080

# --- database ---
POSTGRES_USER=vbx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vbx
# Used when running migrations/tests from the host; docker compose sets its own for the API container.
DATABASE_URL=postgresql+psycopg://vbx:change-me@localhost:5432/vbx

# --- auth ---
# Required. At least 32 characters; the API refuses to start with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Synthetic test accounts created at start-up (passwords are listed in the README test-account table).
VBX_EVALUATOR_PASSWORD=
VBX_REVIEWER_PASSWORD=
VBX_DOCTOR_PASSWORD=
