# Copy this file to .env and fill in real values for local/dev use.
# Never commit the real .env (enforced by .gitignore + gitleaks).

# --- app ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins (CORS allowlist).
CORS_ORIGINS=http://localhost:5173

# --- database ---
POSTGRES_USER=vbx
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vbx
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vbx:change-me@db:5432/vbx

# --- auth (added in Layer 3) ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
